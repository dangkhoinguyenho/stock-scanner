# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# SEC EDGAR requires a descriptive User-Agent identifying you/your app and a contact email
# on every request, or it will start rejecting requests. This is not optional.
# Format SEC asks for: "AppName ContactEmail" e.g. "StockScanner kennynguyen9988@gmail.com"
SEC_EDGAR_USER_AGENT="StockScanner kennynguyen9988@gmail.com"

# Data provider API key(s) — placeholder for Phase 1. Not committed to yet as THE provider,
# see project-spec.md section 23/19 for why multiple providers will likely be needed.
ALPHA_VANTAGE_API_KEY=

# FRED (Federal Reserve Economic Data) — free API key, sign up at
# https://fred.stlouisfed.org/docs/api/api_key.html. Used for the economic
# calendar collector (CPI, PPI, unemployment, payrolls, GDP, Fed funds rate).
FRED_API_KEY=

# Finnhub — free API key, sign up at https://finnhub.io/register (no credit
# card). Used for the news collector (company-specific headlines by date range).
FINNHUB_API_KEY=

# Add further provider keys here as Phase 1 collectors are built (options data, etc.)

# Comma-separated tickers the daily options snapshot job (jobs/daily_options_snapshot.py)
# collects, e.g. WATCHLIST=NFLX,AAPL,TSLA. Defaults to just NFLX if not set.
WATCHLIST=NFLX
